# Copy this file to ".env" and fill it in. Never commit ".env" to GitHub.

PORT=3000

# Gmail example. Use an App Password, NOT your normal Gmail password
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=anshumanprakhar1@gmail.com
SMTP_PASS=your-16-character-app-password

# Where contact-form messages are delivered (defaults to SMTP_USER if left empty)
CONTACT_TO=anshumanprakhar1@gmail.com

# Only needed if the frontend is hosted on a different domain than this server
# (for example the page on Vercel and this API on Render). Comma-separate several.
# CORS_ORIGIN=https://your-portfolio.vercel.app
